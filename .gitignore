# Virtual environment
.venv/
venv/
env/
ENV/
tmp/

# Raw HTML cache (OPERATIONS.md/README.md: "gitignored, regenerated per run,
# never pushed" - resumability depends on the CSVs + crawl logs, never on
# this surviving). Was missing from this file despite being documented and
# never actually committed in this repo's history - closing the gap rather
# than relying on nobody ever running a broad `git add`.
/output/raw/

# Generated GitHub Pages site (built by analysis_scripts/build_site.py in CI)
/site/

# Generated data shards from local test builds of analysis_scripts (e.g.
# participation_map.py) — reproducible from output/processed/rffm/, not
# meant to be committed (unlike the hand-curated one-off files that already
# live directly under reports/).
/reports/data/

# players.parquet is deliberately NOT git-tracked, unlike every other table
# under output/processed/rffm_parquet/ — it's a binary blob that gets fully
# rewritten (no useful git delta) on every commit that touches it, measured
# to cost noticeably more in git history than committing the same data as
# CSV (see analysis_scripts/build_parquet.py's PLAYERS_CURRENT_CSV comment
# and DATA_FINDINGS.md). The git-tracked canonical source is
# output/processed/rffm/players_current.csv instead; regenerate this file
# locally with `build_parquet.py --players-only` after a fresh checkout.
/output/processed/rffm_parquet/players.parquet

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# IDE
.vscode/
.idea/
# .claude/ is mostly personal/local IDE state, but settings.json and
# hooks/ are the repo's own SessionStart hook config (regenerates the
# gitignored players.parquet on session start - see .claude/hooks/
# session-start.sh) and need to be git-tracked for future sessions to
# pick them up, per Claude Code's session-start-hook convention.
.claude/*
!.claude/settings.json
!.claude/hooks/
!.claude/hooks/**
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
